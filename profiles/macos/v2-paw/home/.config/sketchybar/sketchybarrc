#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
sketchybar --hotload off
source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"
ITEM_DIR="$CONFIG_DIR/items"
PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="SF Pro"
PADDINGS=4

# Track only our helper so reloading the bar cannot stop another app's helper.
HELPER=local.dotfiles.sketchybar
PID_FILE="$HOME/Library/Caches/dotfiles-sketchybar-helper.pid"
if [ -f "$PID_FILE" ]; then
  pid=$(cat "$PID_FILE")
  if [[ "$pid" =~ ^[0-9]+$ ]] && [ "$(ps -p "$pid" -o command=)" = "$CONFIG_DIR/helper/helper $HELPER" ]; then
    kill "$pid" 2>/dev/null
  fi
fi
if make -s -C "$CONFIG_DIR/helper"; then
  "$CONFIG_DIR/helper/helper" "$HELPER" >/dev/null 2>&1 &
  mkdir -p "${PID_FILE%/*}"
  echo $! > "$PID_FILE"
fi

sketchybar --bar height=40 position=top color="$TRANSPARENT" border_width=0 \
  shadow=off sticky=on padding_left=14 padding_right=14 margin=0 y_offset=0 \
  notch_width=210 topmost=window
sketchybar --default updates=when_shown \
  icon.font="$FONT:Semibold:13.0" icon.color="$WHITE" \
  icon.padding_left=4 icon.padding_right=4 \
  label.font="GeistMono Nerd Font:Medium:12.0" label.color="$WHITE" \
  label.padding_left=2 label.padding_right=4 padding_left=4 padding_right=4 \
  background.height=28 background.corner_radius=9 background.border_width=0 \
  popup.background.border_width=1 popup.background.corner_radius=10 \
  popup.background.border_color="$POPUP_BORDER_COLOR" \
  popup.background.color="$POPUP_BACKGROUND_COLOR" popup.blur_radius=25 \
  popup.background.shadow.drawing=on scroll_texts=on

island() {
  local name=$1 position=$2
  shift 2
  sketchybar --add bracket "$name" "$@" --set "$name" \
    background.color="$BACKGROUND_1" background.drawing=on
  sketchybar --add item "$name.gap" "$position" --set "$name.gap" \
    width=6 icon.drawing=off label.drawing=off
}

source "$ITEM_DIR/apple.sh"
sketchybar --set apple.logo padding_right=6 icon.color="$YELLOW"
island apple.island left apple.logo
source "$ITEM_DIR/paw.sh"
island spaces.island left '/paw\.space\..*/' space_creator paw.state
source "$ITEM_DIR/front_app.sh"
sketchybar --set front_app label.max_chars=15 icon.background.image.scale=0.75 \
  padding_left=8 padding_right=8
island app.island left front_app
source "$ITEM_DIR/brew.sh"
island brew.island left brew

# Keep the richer Spotify popup; an icon avoids a long title colliding with the notch.
source "$ITEM_DIR/spotify.sh"
sketchybar --set spotify.anchor icon.font="$FONT:Regular:17.0" y_offset=0 \
  background.color="$BACKGROUND_1" background.drawing=on

# Right items are added from the right edge inward: date/time stays at the far right.
source "$ITEM_DIR/calendar.sh"
sketchybar --set calendar icon.font="$FONT:Medium:11.0" label.width=dynamic \
  padding_left=8 padding_right=8 click_script="open -a Calendar"
island clock.island right calendar
source "$ITEM_DIR/github.sh"
island github.island right github.bell
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/cpu.sh"
island system.island right wifi vpn battery volume volume_icon cpu.percent

# File-watch reloads can overlap while sourcing items and corrupt their order/defaults.
sketchybar --hotload off
sketchybar --update
